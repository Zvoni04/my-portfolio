<section class="hero">
  <div class="text-content">
    <h1>Hallo, ich bin <br/><span class="gradient-text">Zvonimir Ljubic</span> 👋</h1>
    <p class="subtitle">Leidenschaftlicher ehemaliger IT-Schüler der HTL Saalfelden mit Fokus auf <strong>Software-Architektur & Webentwicklung</strong>.</p>
    <p class="description">
      Meine Expertise umfasst Sprachen wie Java, Python, C# und JavaScript. Ich entwickle komplexe, objektorientierte C#-Architekturen, nutze Python-Tools für datengetriebene Analysen und widme mich in meiner Freizeit dem Schach (1800 Elo).
    </p>
    <a href="mailto:zvonimir2004@gmail.com" class="btn">Kontakt aufnehmen</a>
  </div>
  <div class="image-wrapper">
    <div class="glow"></div>
    <div class="profile-pic">
      <img src="/Profilepictureportfolio.png" alt="Zvonimir Ljubic Profilbild" />
    </div>
  </div></section>


<style>
  .hero { display: flex; align-items: center; gap: 40px; margin-top: 40px; flex-wrap: wrap-reverse; }
  .text-content { flex: 1; min-width: 300px; }
  
  h1 { font-size: 3.5rem; line-height: 1.1; margin-bottom: 20px; font-weight: 800; }
  .gradient-text {
    background: linear-gradient(90deg, #6366f1, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle { font-size: 1.25rem; color: var(--text-main); margin-bottom: 15px; line-height: 1.6; }
  .description { color: var(--text-muted); line-height: 1.8; margin-bottom: 30px; }

  .btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: 12px 28px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: bold;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .btn:hover { transform: translateY(-3px); box-shadow: 0 10px 20px var(--accent-glow); }

  .image-wrapper { flex: 0.5; display: flex; justify-content: center; position: relative; }
  
  /* Der moderne Glow-Effekt */
  .glow {
    position: absolute;
    width: 250px; height: 250px;
    background: linear-gradient(90deg, #6366f1, #ec4899);
    border-radius: 50%;
    filter: blur(30px);
    opacity: 0.3;
    transition: opacity 0.5s ease;
  }
  .image-wrapper:hover .glow { opacity: 0.7; }

  .profile-pic {
    width: 250px; height: 250px;
    background: var(--card-bg);
    border: 4px solid var(--bg-color);
    border-radius: 50%;
    position: relative;
    z-index: 1;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .profile-pic img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
</style>